{
  "functions": {
    "source": "functions"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/.*/**",
      ".git/**",
      ".claude/**",
      ".agents/**",
      ".github/**",
      ".firebase/**",
      "**/node_modules/**",
      "functions/**",
      "firestore.rules",
      "package.json",
      "package-lock.json",
      "*-debug.log",
      "tests/**",
      "reference/**",
      "public/**",
      "serve.py",
      "sync-to-github.js",
      "HANDOFF.md",
      "README.md",
      "skills-lock.json",
      "*.patch"
    ],
    "rewrites": [
      {
        "source": "/api/analytics",
        "function": "analytics"
      },
      {
        "source": "/api/pay/quote",
        "function": "payQuote"
      },
      {
        "source": "/api/pay/verify",
        "function": "payVerify"
      },
      {
        "source": "/api/pay/status",
        "function": "payStatus"
      },
      {
        "source": "/api/pay/webhook",
        "function": "flwWebhook"
      }
    ],
    "headers": [
      {
        "source": "/",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "**/*.@(html)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "/service-worker.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "/manifest.webmanifest",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, must-revalidate"
          }
        ]
      },
      {
        "source": "/@(js|css|vendor|icons)/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  }
}
